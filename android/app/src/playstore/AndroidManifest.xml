<?xml version="1.0" encoding="utf-8"?>
<!--
  Play Store manifest overlay.
  Merged with higher priority than src/main when -Pplaystore is set.
  tools:node="remove" completely strips the AccessibilityService from the
  final merged manifest, so BIND_ACCESSIBILITY_SERVICE never appears.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Strip REQUEST_INSTALL_PACKAGES (self-update) -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- Strip REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (App power management policy) -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />

    <!-- Strip READ_PHONE_STATE: the cellular generation and signal are a convenience,
         and a phone-state permission on a kiosk browser is exactly the kind of thing
         that costs a Play Store review. Cellular connected/disconnected and airplane
         mode need no permission, so a Play build keeps those. -->
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />

    <!-- Strip WRITE_SETTINGS (Device settings policy) -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:node="remove" />

    <!-- Strip USE_FULL_SCREEN_INTENT: Play restricts it to calling and alarm apps. Without
         it the wake notification of ScreenController.turnScreenOn is shown as a heads-up
         instead of a full-screen intent, and the activity is still started directly. -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove" />

    <!-- Strip the exact alarm permissions (#307): Play restricts them to alarm and calendar apps.
         The screen schedule's wake then falls back to an inexact alarm, which can be late. -->
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />

    <!-- Strip READ_MEDIA_* (photo/video policy) -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />

    <application>
        <!-- Strip AccessibilityService (BIND_ACCESSIBILITY_SERVICE) -->
        <service
            android:name="com.freekiosk.FreeKioskAccessibilityService"
            tools:node="remove" />
    </application>

</manifest>
