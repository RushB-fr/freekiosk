# Auto detect text files and perform LF normalization
* text=auto

# patch-package patches must keep LF line endings.
# On Windows, autocrlf would otherwise check them out as CRLF, which
# patch-package 8 fails to parse ("Failed to apply patch ...") — see #184.
*.patch text eol=lf

# Files pushed to an Android device must keep LF. A CRLF shebang ("#!/system/bin/sh\r")
# is not a valid interpreter path, and init refuses to parse a CRLF .rc file.
scripts/device/* text eol=lf
